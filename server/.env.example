# BioScribe ELN Server Environment Configuration

# Server Port
PORT=5000
NODE_ENV=production

# --- Database Connection Options ---
# Option A: Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/bioscribe_eln

# Option B: Cloud MongoDB Atlas Connection
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bioscribe_eln?retryWrites=true&w=majority

# Security Keys & JWT
JWT_SECRET=bioscribe-super-secret-scientific-eln-token-2026
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
